&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2025-06-11_18:00:00', '2025-06-11_18:00:00',
 end_date   = '2025-06-13_00:00:00', '2025-06-11_18:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = './',
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1, 181,
 j_parent_start    =   1, 181,
 e_we              = 541, 541,
 e_sn              = 541, 541,
 geog_data_res = 'default', 'default',
 dx = 3000.0,
 dy = 3000.0,
 map_proj = 'lambert',
 ref_lat   =  32.6416667,
 ref_lon   = -106.7058333,
 truelat1  =  32.6416667,
 truelat2  =  32.6416667,
 stand_lon = -106.7058333,
 geog_data_path = '/glade/work/wrfhelp/WPS_GEOG',
 opt_geogrid_tbl_path = '/glade/u/home/jaredlee/programs/WPS-4.6-dmpar-casper/geogrid',
/

&ungrib
 out_format = 'WPS',
 prefix = './HRRR_pres',
/

&metgrid
 fg_name = './HRRR_pres',
 io_form_metgrid = 2,
 constants_name = 'TAVGSFC'
 opt_output_from_metgrid_path = './',
 opt_metgrid_tbl_path = '/glade/u/home/jaredlee/programs/WPS-4.6-dmpar-casper/metgrid',
/
